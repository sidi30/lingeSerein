generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  ROLE_CLIENT
  ROLE_LIVREUR
  ROLE_ADMIN
  ROLE_SUPER_ADMIN
}

enum AccommodationType {
  AIRBNB
  GITE
  AUBERGE
  HOTEL
  AUTRE
}

enum ProductRange {
  CONFORT
  HOTEL
  PRESTIGE
  // V2 — extension additive pour le stock des kits (ADR-V2-001/004). Non utilisé par Product (qui n'a plus besoin de range).
  KIT_BAIN
  KIT_LIT
  KIT_COMPLET
}

/// V2 — distingue les kits des articles unitaires pour l'affichage mobile (ADR-V2-001)
enum ProductKind {
  KIT
  ARTICLE
}

enum ProductCategory {
  SERVIETTES
  DRAPS
  TAPIS_BAIN
  LINGE_LIT
  KIT_CUISINE
  ARTICLE_ACCUEIL
}

enum ServiceTypeKind {
  LOCATION
  VENTE
  ENTRETIEN
}

/// @deprecated V2 — conservé pour compat (client réel PRESTIGE). Le modèle V2 = Pack Sérénité via SubscriptionConfig + snapshots (ADR-V2-003). Aucune valeur retirée (DROP VALUE Postgres impossible proprement).
enum SubscriptionPlan {
  ESSENTIELLE
  CONFORT
  PRESTIGE
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  PAST_DUE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderSource {
  MOBILE
  QUOTE_CONVERSION
  MANUAL
}

enum QuoteStatus {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
  EXPIRE
}

enum DeliveryRoundStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DeliveryStopStatus {
  PENDING
  COMPLETED
  SKIPPED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

/// Origine d'un client — distingue les comptes app des clients saisis à la main
enum ClientSource {
  APP
  ADMIN
  BOUCHE_A_OREILLE
  MARCHE
  DEVIS
  SITE_WEB
}

enum NotificationType {
  // Activité commerciale — alimente les badges "non lus" de l'admin
  QUOTE_CREATED
  ORDER_CREATED
  USER_CREATED
  STOCK_LOW
  // Calendrier de rotations — relances de reprise du linge loué.
  // Ces valeurs n'alimentent AUCUN badge admin : NotificationsService.SECTION_BY_TYPE
  // ignore silencieusement les types qu'il ne connaît pas, les compteurs existants
  // (devis/commandes/utilisateurs/stock) sont donc inchangés.
  ROTATION_REMINDER
  ROTATION_TODAY
  ROTATION_OVERDUE
  ROTATION_PICKED_UP
  DELIVERY_REMINDER
  DELIVERY_CONFIRMED
  DELIVERY_CANCELLED
  DELIVERY_DELAYED
  PAYMENT_FAILED
  PAYMENT_SUCCESS
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_EXPIRING
  ACCOUNT_LOCKED
  GENERAL
}

enum NotificationChannel {
  PUSH
  EMAIL
  BOTH
}

/// Régime contractuel d'une rotation — conditionne la durée de détention (7 j / 14 j).
enum RotationFormule {
  PONCTUEL
  ABONNEMENT
}

/// Cycle de vie d'une rotation. Miroir de RotationStatus (@lingengo/shared/rotation).
enum RotationStatus {
  PLANIFIEE
  LIVREE
  REPRISE
  EN_RETARD
  ANNULEE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  ACCOUNT_LOCKED
  PASSWORD_CHANGED
  EXPORT_DATA
  DELETE_ACCOUNT
}

// ============================================================================
// OPÉRATEUR & ZONES (multi-opérateur, multi-zone dès v1)
// ============================================================================

/// Opérateur du service (permet l'expansion multi-partenaire)
model Operator {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(200)
  email         String    @unique @db.VarChar(320)
  phone         String?   @db.VarChar(20) // chiffré AES-256 en application
  address       String?   @db.Text // chiffré AES-256 en application
  siret         String?   @map("siret") @db.VarChar(14) // SIRET 14 chiffres
  legalMentions String?   @map("legal_mentions") @db.Text // mentions légales PDF devis
  // Coordonnées bancaires imprimées sur les factures. Stockées normalisées
  // (sans espaces, en majuscules) : 34 = longueur IBAN maximale (norme ISO 13616),
  // 11 = BIC long (8 caractères + branche facultative sur 3).
  iban          String?   @db.VarChar(34)
  bic           String?   @db.VarChar(11)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  zones              DeliveryZone[]
  users              User[]
  products           Product[]
  deliveryRounds     DeliveryRound[]
  invoices           Invoice[]
  quotes             Quote[]
  rotations          Rotation[]
  stockItems         StockItem[]
  subscriptionConfig SubscriptionConfig? // V2 — config Pack Sérénité (ADR-V2-002)

  @@map("operators")
}

/// Zone de livraison géographique
model DeliveryZone {
  id               String   @id @default(uuid()) @db.Uuid
  operatorId       String   @map("operator_id") @db.Uuid
  name             String   @db.VarChar(200) // ex: "Vaucluse Nord", "Luberon"
  postalCodes      String[] @map("postal_codes") // codes postaux couverts
  deliveryFeeCents Int      @default(0) @map("delivery_fee_cents") // tarif livraison en centimes
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  operator       Operator           @relation(fields: [operatorId], references: [id])
  users          User[]
  deliveryRounds DeliveryRound[]
  schedules      DeliverySchedule[]

  @@map("delivery_zones")
}

// ============================================================================
// UTILISATEURS
// ============================================================================

/// Utilisateur (client, livreur, admin)
model User {
  id                  String             @id @default(uuid()) @db.Uuid
  operatorId          String             @map("operator_id") @db.Uuid
  zoneId              String?            @map("zone_id") @db.Uuid
  email               String?            @unique @db.VarChar(320) // null = client sans compte (créé par l'admin)
  passwordHash        String?            @map("password_hash") @db.Text // null = inconnectable
  name                String             @db.VarChar(200)
  phone               String?            @db.VarChar(20)
  address             String?            @db.Text
  accommodationType   AccommodationType? @map("accommodation_type")
  role                Role               @default(ROLE_CLIENT)
  isActive            Boolean            @default(true) @map("is_active")
  isEmailVerified     Boolean            @default(false) @map("is_email_verified")
  emailVerifiedAt     DateTime?          @map("email_verified_at")
  loginAttempts       Int                @default(0) @map("login_attempts")
  lockedUntil         DateTime?          @map("locked_until")
  mfaEnabled          Boolean            @default(false) @map("mfa_enabled")
  mfaSecret           String?            @map("mfa_secret") @db.Text // chiffré AES-256
  mfaRecoveryCodes    String?            @map("mfa_recovery_codes") @db.Text // chiffré AES-256
  deliveryPin         String?            @map("delivery_pin") @db.VarChar(255) // hash bcrypt PIN 6 chiffres (livreur)
  stockAlertThreshold Int                @default(30) @map("stock_alert_threshold") // pourcentage
  preferredTimeSlot   String?            @map("preferred_time_slot") @db.VarChar(20) // ex: "08:00-10:00"
  stripeCustomerId    String?            @unique @map("stripe_customer_id") @db.VarChar(255)
  companyName         String?            @map("company_name") @db.VarChar(200) // établissement (distinct du contact)
  city                String?            @db.VarChar(120)
  postalCode          String?            @map("postal_code") @db.VarChar(10)
  // Commune de livraison, code INSEE — SEUL identifiant stable de l'adresse.
  // Le nom change (fusions de communes) et le code postal ne désigne pas une
  // commune : 84100 couvre Orange ET Uchaux, et 7 codes postaux du Vaucluse sont
  // à cheval sur deux paliers tarifaires. C'est ce code, choisi dans la liste
  // fermée de `@lingengo/shared` (VAUCLUSE_COMMUNES), qui fixe le prix de la
  // livraison — plus jamais un code postal saisi librement par le client.
  communeInsee        String?            @map("commune_insee") @db.VarChar(5)
  rating              Int?               @db.SmallInt // appréciation interne 1-5 (CHECK en base)
  requirements        String?            @db.Text // exigences particulières du client
  source              ClientSource       @default(APP)
  notes               String?            @db.Text // notes internes (admin)
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  deletedAt           DateTime?          @map("deleted_at")

  operator             Operator              @relation(fields: [operatorId], references: [id])
  zone                 DeliveryZone?         @relation(fields: [zoneId], references: [id])
  refreshTokens        RefreshToken[]
  subscription         Subscription?
  orders               Order[]
  stockMovements       StockMovement[]
  notifications        Notification[]
  notificationSettings NotificationSetting[]
  deviceTokens         DeviceToken[]
  consents             Consent[]
  deliveryStops        DeliveryStop[]        @relation("ClientStops")
  deliveredStops       DeliveryStop[]        @relation("DriverStops")
  deliveryRounds       DeliveryRound[]       @relation("DriverRounds")
  invoices             Invoice[]
  auditLogs            AuditLog[]
  quotesAsClient       Quote[]               @relation("QuoteClient")
  quotesCreated        Quote[]               @relation("QuoteCreator")
  rotations            Rotation[]            @relation("RotationClient")

  @@index([email])
  @@index([role])
  @@index([operatorId])
  @@index([zoneId])
  @@index([stripeCustomerId])
  @@index([operatorId, role, deletedAt])
  @@index([companyName])
  @@map("users")
}

/// Refresh token rotatif
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique @db.VarChar(500)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Vérification email
model EmailVerification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique @db.VarChar(500)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([token])
  @@index([userId])
  @@map("email_verifications")
}

// ============================================================================
// CATALOGUE PRODUITS (scalable — JSONB pour attributs dynamiques)
// ============================================================================

/// Type de service (location, vente, entretien)
model ServiceType {
  id          String          @id @default(uuid()) @db.Uuid
  kind        ServiceTypeKind @unique
  name        String          @db.VarChar(200) // ex: "Location de linge"
  description String?         @db.Text
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  products Product[]

  @@map("service_types")
}

/// Produit (serviette, drap, tapis, etc.)
model Product {
  id                  String           @id @default(uuid()) @db.Uuid
  operatorId          String           @map("operator_id") @db.Uuid
  serviceTypeId       String           @map("service_type_id") @db.Uuid
  // V2 — slug = identifiant métier stable, unicité portée ici (ADR-V2-001). Nullable : lignes legacy sans slug restent valides (NULL ignoré par l'unique).
  slug                String?          @unique @db.VarChar(60)
  kind                ProductKind      @default(ARTICLE) // V2 — KIT vs ARTICLE (affichage mobile)
  category            ProductCategory? // V2 — nullable (kits sans catégorie)
  range               ProductRange? // V2 — nullable, n'est plus discriminant d'identité
  name                String           @db.VarChar(200) // ex: "Kit Bain", "Serviette de toilette"
  description         String?          @db.Text
  priceCents          Int              @map("price_cents") // prix unitaire en centimes
  attributes          Json             @default("{}") @db.JsonB // grammage, dimensions, matière, etc.
  imageUrl            String?          @map("image_url") @db.VarChar(500)
  stockAlertThreshold Int              @default(3) @map("stock_alert_threshold") // seuil alerte stock (unités)
  isActive            Boolean          @default(true) @map("is_active")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  deletedAt           DateTime?        @map("deleted_at")

  operator             Operator              @relation(fields: [operatorId], references: [id])
  serviceType          ServiceType           @relation(fields: [serviceTypeId], references: [id])
  linenBatches         LinenBatch[]
  orderItems           OrderItem[]
  subscriptionProducts SubscriptionProduct[]

  // V2 — @@unique([operatorId, category, range]) RETIRÉE (ADR-V2-001) : incompatible avec 9 produits KITS. Unicité = slug.
  @@index([kind])
  @@index([category])
  @@index([range])
  @@index([serviceTypeId])
  @@map("products")
}

/// Lot de linge physique (suivi usure/lavages)
model LinenBatch {
  id            String    @id @default(uuid()) @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  batchCode     String    @unique @map("batch_code") @db.VarChar(50) // code interne du lot
  quantity      Int // nombre d'unités dans le lot
  washCount     Int       @default(0) @map("wash_count")
  maxWashCycles Int       @default(100) @map("max_wash_cycles")
  isRetired     Boolean   @default(false) @map("is_retired")
  retiredAt     DateTime? @map("retired_at")
  purchasedAt   DateTime  @map("purchased_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([washCount])
  @@index([isRetired])
  @@map("linen_batches")
}

// ============================================================================
// ABONNEMENTS
// ============================================================================

/// Abonnement client
model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @unique @map("user_id") @db.Uuid
  plan                 SubscriptionPlan? // V2 — nullable (ADR-V2-003). Legacy pour client réel ; null pour Pack Sérénité.
  status               SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id") @db.VarChar(255)
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  // V2 — Pack Sérénité : snapshots immuables au moment de la souscription (ADR-V2-006)
  priceCents           Int?               @map("price_cents") // prix mensuel snapshot (null pour legacy non migré)
  minEngagementMonths  Int                @default(3) @map("min_engagement_months")
  committedUntil       DateTime?          @map("committed_until") // startDate + minEngagementMonths (calendaire)
  kitBainQty           Int                @default(8) @map("kit_bain_qty")
  kitLitQty            Int                @default(4) @map("kit_lit_qty")
  pausedAt             DateTime?          @map("paused_at")
  pauseMonthsUsed      Int                @default(0) @map("pause_months_used") // max 2/an
  cancelledAt          DateTime?          @map("cancelled_at")
  cancelEffectiveAt    DateTime?          @map("cancel_effective_at") // +noticePeriodDays préavis
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user     User                  @relation(fields: [userId], references: [id])
  products SubscriptionProduct[]

  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

/// Produits inclus dans un abonnement (découplé — permet d'ajouter des produits)
model SubscriptionProduct {
  id             String @id @default(uuid()) @db.Uuid
  subscriptionId String @map("subscription_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  quantity       Int // nombre de sets inclus

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@unique([subscriptionId, productId])
  @@map("subscription_products")
}

/// V2 — Configuration de l'offre d'abonnement Pack Sérénité, paramétrable par opérateur (ADR-V2-002)
model SubscriptionConfig {
  id                  String   @id @default(uuid()) @db.Uuid
  operatorId          String   @unique @map("operator_id") @db.Uuid
  planName            String   @default("Pack Sérénité") @map("plan_name") @db.VarChar(100)
  priceCents          Int      @default(8900) @map("price_cents")
  kitBainQty          Int      @default(8) @map("kit_bain_qty")
  kitLitQty           Int      @default(4) @map("kit_lit_qty")
  minEngagementMonths Int      @default(3) @map("min_engagement_months")
  noticePeriodDays    Int      @default(30) @map("notice_period_days")
  /// Facturation récurrente : TVA appliquée ou non. `false` par défaut, comme
  /// les devis — l'opérateur relève de la franchise en base (art. 293 B du CGI)
  /// tant qu'il n'a pas basculé. Facturer une TVA qu'on n'est pas autorisé à
  /// collecter est la faute grave ; l'oublier se rattrape.
  tvaApplicable       Boolean  @default(false) @map("tva_applicable")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  operator Operator @relation(fields: [operatorId], references: [id])

  @@map("subscription_configs")
}

// ============================================================================
// COMMANDES
// ============================================================================

/// Commande (ponctuelle ou générée par abonnement)
model Order {
  id                  String      @id @default(uuid()) @db.Uuid
  userId              String      @map("user_id") @db.Uuid
  orderNumber         String      @unique @map("order_number") @db.VarChar(30) // ex: LNG-2026-000001
  status              OrderStatus @default(PENDING)
  source              OrderSource @default(MOBILE) @map("source") // origine de la commande
  isRecurring         Boolean     @default(false) @map("is_recurring") // commande auto via abonnement
  totalCents          Int         @map("total_cents") // sous-total des ARTICLES, hors livraison
  /// Frais de livraison figés à la création (barème computeDeliveryFee de @lingengo/shared).
  /// Le total à payer vaut total_cents + delivery_fee_cents — `total_cents` garde sa
  /// sémantique d'origine, plusieurs écrans s'en servent comme sous-total d'articles.
  deliveryFeeCents    Int         @default(0) @map("delivery_fee_cents")
  /// Vrai quand le barème ne publie AUCUN tarif (hors zone, urgence Flash < 3 h) :
  /// les frais valent alors 0 en base et restent à chiffrer à la main sur le devis.
  /// Sans ce drapeau, « livraison offerte » et « livraison à chiffrer » seraient
  /// indiscernables une fois la commande enregistrée.
  deliveryFeeSurDevis Boolean     @default(false) @map("delivery_fee_sur_devis")
  deliveryDate        DateTime    @map("delivery_date") @db.Date
  timeSlot            String?     @map("time_slot") @db.VarChar(20)
  specialNotes        String?     @map("special_notes") @db.Text
  cancelledAt         DateTime?   @map("cancelled_at")
  cancelledReason     String?     @map("cancelled_reason") @db.Text
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  deletedAt           DateTime?   @map("deleted_at")

  user           User          @relation(fields: [userId], references: [id])
  items          OrderItem[]
  deliveryStop   DeliveryStop?
  quote          Quote?        @relation("QuoteOrder")
  /// Devis ÉMIS À PARTIR de cette commande (POST /quotes/from-order/:orderId).
  /// Relation distincte de `quote` : celle-ci dit « ce devis a produit cette
  /// commande », celle-là « cette commande a produit ce devis ». Les confondre
  /// afficherait « commande issue du devis X » sur une commande saisie au comptoir.
  quoteFromOrder Quote?        @relation("QuoteFromOrder")

  @@index([userId])
  @@index([status])
  @@index([source])
  @@index([deliveryDate])
  @@index([orderNumber])
  @@map("orders")
}

/// Ligne de commande
model OrderItem {
  id         String @id @default(uuid()) @db.Uuid
  orderId    String @map("order_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  quantity   Int
  unitCents  Int    @map("unit_cents") // prix unitaire au moment de la commande
  totalCents Int    @map("total_cents")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ============================================================================
// DEVIS
// ============================================================================

/// Devis commercial (F1)
model Quote {
  id                 String      @id @default(uuid()) @db.Uuid
  numero             String      @unique @db.VarChar(20) // format LSQ-YYYY-NNNN
  operatorId         String      @map("operator_id") @db.Uuid
  status             QuoteStatus @default(BROUILLON)
  clientNom          String      @map("client_nom") @db.VarChar(200)
  clientEmail        String?     @map("client_email") @db.VarChar(320)
  clientTel          String?     @map("client_tel") @db.VarChar(20)
  clientAdresse      String?     @map("client_adresse") @db.Text
  userId             String?     @map("user_id") @db.Uuid // client lié optionnel
  remisePct          Int         @default(0) @map("remise_pct") // centièmes de % : 1000 = 10%
  livraisonCents     Int         @default(0) @map("livraison_cents")
  /// Vrai quand les frais de livraison restent À CHIFFRER (hors zone, urgence
  /// Flash) : 0 € ne vaut alors PAS gratuité. Pendant de `Order.deliveryFeeSurDevis`,
  /// qu'un devis émis depuis une commande doit reporter — sans ce drapeau, le
  /// devis imprimait « Livraison offerte » dans son tableau de totaux et
  /// PROMETTAIT au client, sur le document qu'il signe, la gratuité d'une course
  /// hors secteur. La valeur redescend ensuite dans la facture (`metadata.livraisonLabel`).
  livraisonSurDevis  Boolean     @default(false) @map("livraison_sur_devis")
  tvaApplicable      Boolean     @default(false) @map("tva_applicable")
  notes              String?     @db.Text
  validiteJours      Int         @default(30) @map("validite_jours")
  dateEnvoi          DateTime?   @map("date_envoi")
  dateReponse        DateTime?   @map("date_reponse")
  convertedToOrderId String?     @unique @map("converted_to_order_id") @db.Uuid // lien si converti
  /// Commande D'ORIGINE quand le devis a été émis depuis une commande.
  /// UNIQUE : c'est la base elle-même qui garantit « un seul devis par commande »
  /// (POST /quotes/from-order/:orderId est idempotent) — une vérification
  /// applicative seule laisserait passer un double-clic concurrent.
  fromOrderId        String?     @unique @map("from_order_id") @db.Uuid
  createdBy          String      @map("created_by") @db.Uuid // userId admin créateur
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  deletedAt          DateTime?   @map("deleted_at")

  operator  Operator    @relation(fields: [operatorId], references: [id])
  user      User?       @relation("QuoteClient", fields: [userId], references: [id])
  creator   User        @relation("QuoteCreator", fields: [createdBy], references: [id])
  order     Order?      @relation("QuoteOrder", fields: [convertedToOrderId], references: [id])
  // SetNull et non Restrict : un devis est une pièce commerciale qui doit survivre
  // à la disparition de la commande qui l'a fait naître, sans la bloquer.
  fromOrder Order?      @relation("QuoteFromOrder", fields: [fromOrderId], references: [id], onDelete: SetNull)
  lignes    QuoteLine[]
  invoices  Invoice[]
  rotations Rotation[]

  @@index([operatorId])
  @@index([status])
  @@index([userId])
  @@index([numero])
  @@index([createdAt])
  @@map("quotes")
}

/// Ligne de devis
model QuoteLine {
  id          String @id @default(uuid()) @db.Uuid
  quoteId     String @map("quote_id") @db.Uuid
  designation String @db.VarChar(300)
  qty         Int
  unitCents   Int    @map("unit_cents") // prix unitaire en centimes
  position    Int // ordre d'affichage 0..n

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_lines")
}

// ============================================================================
// LIVRAISONS & TOURNÉES
// ============================================================================

/// Tournée de livraison
model DeliveryRound {
  id          String              @id @default(uuid()) @db.Uuid
  operatorId  String              @map("operator_id") @db.Uuid
  zoneId      String?             @map("zone_id") @db.Uuid
  driverId    String              @map("driver_id") @db.Uuid
  date        DateTime            @db.Date
  status      DeliveryRoundStatus @default(PLANNED)
  startedAt   DateTime?           @map("started_at")
  completedAt DateTime?           @map("completed_at")
  notes       String?             @db.Text
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  operator Operator       @relation(fields: [operatorId], references: [id])
  zone     DeliveryZone?  @relation(fields: [zoneId], references: [id])
  driver   User           @relation("DriverRounds", fields: [driverId], references: [id])
  stops    DeliveryStop[]

  @@index([date])
  @@index([driverId])
  @@index([status])
  @@map("delivery_rounds")
}

/// Arrêt dans une tournée
model DeliveryStop {
  id                  String             @id @default(uuid()) @db.Uuid
  roundId             String             @map("round_id") @db.Uuid
  orderId             String?            @unique @map("order_id") @db.Uuid
  clientId            String             @map("client_id") @db.Uuid
  driverId            String             @map("driver_id") @db.Uuid
  stopOrder           Int                @map("stop_order") // position dans la tournée
  status              DeliveryStopStatus @default(PENDING)
  setsToDeliver       Int                @map("sets_to_deliver")
  setsDelivered       Int?               @map("sets_delivered")
  dirtyPickedUp       Int?               @map("dirty_picked_up") // sets sales récupérés
  qrCodeScanned       Boolean            @default(false) @map("qr_code_scanned")
  photoUrl            String?            @map("photo_url") @db.VarChar(500) // preuve de dépôt (S3 chiffré)
  /// @deprecated Réservé à une URL d'image hébergée. NE PAS y écrire la signature
  /// capturée sur mobile : une data-URL SVG pèse ~6,4 Ko et ne tient pas dans 500
  /// caractères. Utiliser `signatureData` ci-dessous.
  signatureUrl        String?            @map("signature_url") @db.VarChar(500)
  /// Signature manuscrite du client, capturée sur mobile (data-URL SVG/PNG).
  /// TEXT et non VarChar : c'est la preuve de remise, elle ne doit jamais être tronquée.
  signatureData       String?            @map("signature_data") @db.Text
  signataireNom       String?            @map("signataire_nom") @db.VarChar(200)
  /// Le client déclare la livraison conforme. null = non renseigné (arrêts antérieurs
  /// à la capture de signature), distinct de false qui est un refus explicite.
  conforme            Boolean?
  /// Réserves émises à la remise — le texte fait foi en cas de litige.
  reserves            String?            @db.Text
  specialInstructions String?            @map("special_instructions") @db.Text
  completedAt         DateTime?          @map("completed_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  round     DeliveryRound @relation(fields: [roundId], references: [id])
  order     Order?        @relation(fields: [orderId], references: [id])
  client    User          @relation("ClientStops", fields: [clientId], references: [id])
  driver    User          @relation("DriverStops", fields: [driverId], references: [id])
  rotations Rotation[]

  @@index([roundId])
  @@index([clientId])
  @@index([status])
  @@map("delivery_stops")
}

// ============================================================================
// STOCK
// ============================================================================

/// Mouvement de stock (chaque livraison/retour/lavage crée un mouvement)
model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @map("user_id") @db.Uuid // client concerné
  productRange ProductRange      @map("product_range")
  type         StockMovementType
  quantity     Int // positif = ajout chez le client, négatif = retrait
  reason       String?           @db.VarChar(500) // ex: "Livraison #LNG-2026-000001", "Récupération linge sale"
  createdAt    DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([type])
  @@map("stock_movements")
}

enum StockMovementType {
  DELIVERY // livraison de propre au client
  PICKUP_DIRTY // récupération de sale chez le client
  WASH_COMPLETE // lot lavé, retour en stock propre
  ADJUSTMENT // correction manuelle admin
  RETIREMENT // réforme (usure)
}

/// Stock actuel du client (vue dénormalisée, mise à jour à chaque mouvement)
model ClientStock {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @map("user_id") @db.Uuid
  productRange       ProductRange @map("product_range")
  cleanSets          Int          @default(0) @map("clean_sets") // propres chez le client
  dirtySets          Int          @default(0) @map("dirty_sets") // sales à récupérer
  totalInCirculation Int          @default(0) @map("total_in_circulation") // total attribué au client

  @@unique([userId, productRange])
  @@index([userId])
  @@map("client_stocks")
}

/// Stock global de l'opérateur (par gamme)
model OperatorStock {
  id             String       @id @default(uuid()) @db.Uuid
  operatorId     String       @map("operator_id") @db.Uuid
  productRange   ProductRange @map("product_range")
  cleanAvailable Int          @default(0) @map("clean_available") // propres en stock (garage)
  dirtyPending   Int          @default(0) @map("dirty_pending") // sales en attente de lavage
  inCirculation  Int          @default(0) @map("in_circulation") // en circulation chez les clients
  retired        Int          @default(0) // réformés

  @@unique([operatorId, productRange])
  @@map("operator_stocks")
}

// ============================================================================
// FACTURATION
// ============================================================================

/// Facture (Factur-X : PDF/A-3 + XML CII)
/// Facture.
///
/// Deux origines cohabitent sur la même table et la même séquence de numérotation :
///  - facturation d'ABONNEMENT (worker mensuel) : `userId` + `periodStart`/`periodEnd` ;
///  - facturation d'un DEVIS B2B (admin) : `quoteId` + snapshot client dénormalisé,
///    le client n'ayant souvent aucun compte dans `users`.
/// D'où la nullabilité de `userId` et de la période : ce sont des champs propres à
/// l'un ou l'autre cas, jamais aux deux. Le snapshot client (clientNom/Email/Adresse)
/// suit la même logique que Quote — une facture émise ne doit pas changer si la
/// fiche client est modifiée plus tard.
model Invoice {
  id                    String        @id @default(uuid()) @db.Uuid
  operatorId            String        @map("operator_id") @db.Uuid
  userId                String?       @map("user_id") @db.Uuid // null : client sans compte (facture issue d'un devis)
  quoteId               String?       @map("quote_id") @db.Uuid // devis source, si la facture en découle
  invoiceNumber         String        @unique @map("invoice_number") @db.VarChar(30) // ex: FACT-2026-0001
  status                InvoiceStatus @default(DRAFT)
  clientNom             String?       @map("client_nom") @db.VarChar(200) // snapshot figé à l'émission
  clientEmail           String?       @map("client_email") @db.VarChar(320)
  clientAdresse         String?       @map("client_adresse") @db.Text
  totalHtCents          Int           @map("total_ht_cents") // HT en centimes
  vatRate               Int           @default(2000) @map("vat_rate") // 20.00% → 2000 ; 0 si art. 293 B CGI
  vatAmountCents        Int           @map("vat_amount_cents")
  totalTtcCents         Int           @map("total_ttc_cents") // TTC en centimes
  periodStart           DateTime?     @map("period_start") @db.Date // abonnement uniquement
  periodEnd             DateTime?     @map("period_end") @db.Date // abonnement uniquement
  dueDate               DateTime      @map("due_date") @db.Date
  paidAt                DateTime?     @map("paid_at")
  stripeInvoiceId       String?       @unique @map("stripe_invoice_id") @db.VarChar(255)
  stripePaymentIntentId String?       @map("stripe_payment_intent_id") @db.VarChar(255)
  pdfUrl                String?       @map("pdf_url") @db.VarChar(500) // PDF Factur-X signé
  xmlUrl                String?       @map("xml_url") @db.VarChar(500) // XML CII
  metadata              Json          @default("{}") @db.JsonB // lignes de détail, mentions légales
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  deletedAt             DateTime?     @map("deleted_at") // soft-delete BROUILLON only (obligation de conservation)

  operator  Operator   @relation(fields: [operatorId], references: [id])
  // onDelete: Restrict explicite — le défaut Prisma d'une relation optionnelle est
  // SET NULL, qui viderait le client ou le devis source d'une facture déjà émise.
  // Une facture est une pièce comptable : elle ne doit jamais perdre son rattachement.
  user      User?      @relation(fields: [userId], references: [id], onDelete: Restrict)
  quote     Quote?     @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  rotations Rotation[]

  @@index([userId])
  @@index([quoteId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@index([invoiceNumber])
  @@map("invoices")
}

// ============================================================================
// ROTATIONS (calendrier de reprise du linge loué)
// ============================================================================

/// Rotation — un aller-retour de linge loué.
///
/// Le linge PART chez le client et DOIT revenir : cette table est ce qui manquait
/// pour suivre ce cycle. Une rotation naît de l'événement qui fait sortir le linge
/// (émission d'une facture, ou passage d'une tournée) et se clôt à la reprise.
///
/// `dateReprisePrevue` = `dateLivraison` + la durée de détention de la formule
/// (7 jours en ponctuel — seuil hebdomadaire para-hôtelier ; 14 jours en
/// abonnement — article 7 du contrat). Voir DETENTION_DAYS dans
/// @lingengo/shared/rotation : la règle vit là-bas, pas ici.
///
/// Snapshot client dénormalisé (clientNom/Email/Adresse) et `userId` nullable :
/// même parti pris que Quote et Invoice — le client d'un devis n'a très souvent
/// aucun compte dans `users`, et une tournée déjà effectuée ne doit pas changer
/// d'adresse parce que la fiche client a été corrigée depuis.
model Rotation {
  id                     String          @id @default(uuid()) @db.Uuid
  operatorId             String          @map("operator_id") @db.Uuid
  userId                 String?         @map("user_id") @db.Uuid // null : client sans compte
  clientNom              String          @map("client_nom") @db.VarChar(200)
  clientEmail            String?         @map("client_email") @db.VarChar(320)
  clientAdresse          String?         @map("client_adresse") @db.Text
  quoteId                String?         @map("quote_id") @db.Uuid
  invoiceId              String?         @map("invoice_id") @db.Uuid
  deliveryStopId         String?         @map("delivery_stop_id") @db.Uuid // arrêt de tournée qui a livré
  formule                RotationFormule @default(PONCTUEL)
  status                 RotationStatus  @default(PLANIFIEE)
  dateLivraison          DateTime        @map("date_livraison") @db.Date
  dateReprisePrevue      DateTime        @map("date_reprise_prevue") @db.Date
  dateRepriseReelle      DateTime?       @map("date_reprise_reelle") @db.Date
  /// N° de passage pour un abonnement (1, 2, 3…) — null en location ponctuelle.
  passage                Int?
  /// Retard > RETARD_ESCALADE_JOURS : le remplacement DEVIENT facturable au barème.
  /// Posé par le cron, jamais facturé automatiquement — la décision reste humaine.
  facturableRemplacement Boolean         @default(false) @map("facturable_remplacement")
  /// Horodatage de l'EMAIL de rappel J-1 réellement accepté par le mailer (HTTP 200).
  /// Distinct de la notification in-app : si le mailer est indisponible, la notification
  /// part quand même et ce champ reste null, ce qui autorise une nouvelle tentative au
  /// prochain passage du cron. Marquer avant d'avoir la confirmation ferait taire
  /// définitivement un rappel jamais envoyé.
  reminderSentAt         DateTime?       @map("reminder_sent_at")
  /// Idem pour l'email de relance de retard.
  overdueNotifiedAt      DateTime?       @map("overdue_notified_at")
  notes                  String?         @db.Text
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")
  deletedAt              DateTime?       @map("deleted_at")

  operator     Operator       @relation(fields: [operatorId], references: [id])
  // onDelete: SetNull explicite sur le client : supprimer un compte ne doit pas
  // effacer la trace du linge encore dehors — le snapshot nominatif suffit à
  // identifier chez qui aller le reprendre.
  user         User?          @relation("RotationClient", fields: [userId], references: [id], onDelete: SetNull)
  quote        Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  invoice      Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  deliveryStop DeliveryStop?  @relation(fields: [deliveryStopId], references: [id], onDelete: SetNull)
  lignes       RotationLine[]

  @@index([operatorId, status])
  @@index([operatorId, dateReprisePrevue])
  @@index([dateReprisePrevue])
  @@index([userId])
  @@index([invoiceId])
  @@index([deliveryStopId])
  @@map("rotations")
}

/// Ligne de rotation — ce qui est réellement sorti, et ce qui est réellement revenu.
///
/// `productSlug` est NULLABLE et sans clé étrangère vers `products` : il vaut null
/// quand la désignation libre de la facture n'a pas pu être rapprochée du catalogue
/// (resolveProductSlug ne devine pas). La ligne reste alors parfaitement valide pour
/// le suivi de reprise — elle ne bouge simplement pas le stock. Mieux vaut un stock
/// incomplet qu'un stock faux.
model RotationLine {
  id          String  @id @default(uuid()) @db.Uuid
  rotationId  String  @map("rotation_id") @db.Uuid
  productSlug String? @map("product_slug") @db.VarChar(60)
  designation String  @db.VarChar(300)
  qtyLivree   Int     @map("qty_livree")
  /// null = reprise pas encore saisie. 0 = rien n'est revenu (constat, pas absence de saisie).
  qtyReprise  Int?    @map("qty_reprise")
  position    Int     @default(0)

  rotation Rotation @relation(fields: [rotationId], references: [id], onDelete: Cascade)

  @@index([rotationId])
  @@index([productSlug])
  @@map("rotation_lines")
}

/// Parc de linge de l'opérateur, PAR SLUG catalogue.
///
/// Comble le trou du modèle actuel : StockMovement / ClientStock / OperatorStock
/// sont clés par ProductRange (CONFORT/HOTEL/PRESTIGE), gammes héritées de la v1
/// qui ne décrivent pas le catalogue vendu aujourd'hui (kit-bain, kit-complet…).
/// Ces tables restent en place et intactes — celle-ci s'ajoute, elle ne remplace rien.
///
/// `disponible` n'est PAS stocké : c'est totalOwned − inCirculation − dirtyPending
/// − retired, calculé à la lecture. Une quantité dérivée qu'on persiste finit
/// toujours par mentir quand une des trois autres bouge sans elle.
model StockItem {
  id            String   @id @default(uuid()) @db.Uuid
  operatorId    String   @map("operator_id") @db.Uuid
  productSlug   String   @map("product_slug") @db.VarChar(60)
  /// Parc total possédé (saisi par l'exploitant à l'inventaire).
  totalOwned    Int      @default(0) @map("total_owned")
  /// Sorti, actuellement chez les clients.
  inCirculation Int      @default(0) @map("in_circulation")
  /// Revenu sale, en attente de lavage.
  dirtyPending  Int      @default(0) @map("dirty_pending")
  /// Réformé (usure, perte, non restitué).
  retired       Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  operator Operator @relation(fields: [operatorId], references: [id])

  @@unique([operatorId, productSlug])
  @@index([operatorId])
  @@map("stock_items")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

/// Notification envoyée à un utilisateur
model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  type      NotificationType
  channel   NotificationChannel @default(BOTH)
  title     String              @db.VarChar(200)
  body      String              @db.Text
  data      Json                @default("{}") @db.JsonB // deeplink, metadata
  readAt    DateTime?           @map("read_at")
  sentAt    DateTime?           @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

/// Jeton de notification push d'un appareil (Expo).
///
/// Sans cette table, aucun push ne peut partir : le worker n'a aucune adresse où
/// écrire. Un même utilisateur peut avoir plusieurs appareils, d'où la clé sur le
/// jeton et non sur l'utilisateur.
///
/// `token` est unique GLOBALEMENT et non par utilisateur : réinstaller l'app sur un
/// téléphone revendu réattribue le même jeton à quelqu'un d'autre. L'upsert sur le
/// jeton transfère alors la propriété au dernier inscrit — sans quoi l'ancien
/// propriétaire continuerait de recevoir les notifications du nouveau.
model DeviceToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  token      String   @unique @db.VarChar(255)
  /// "ios" | "android" | "web" — normalisé en minuscules côté API.
  platform   String   @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")
  /// Dernière présentation du jeton — permet de purger les appareils dormants.
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

/// Préférences de notification par utilisateur et par type
model NotificationSetting {
  id      String              @id @default(uuid()) @db.Uuid
  userId  String              @map("user_id") @db.Uuid
  type    NotificationType
  channel NotificationChannel @default(BOTH)
  enabled Boolean             @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_settings")
}

// ============================================================================
// RGPD — CONSENTEMENTS
// ============================================================================

/// Enregistrement du consentement RGPD (horodaté + version du document)
model Consent {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  type            ConsentType
  documentVersion String      @map("document_version") @db.VarChar(20) // ex: "1.0", "2.1"
  accepted        Boolean
  ipAddress       String?     @map("ip_address") @db.VarChar(45) // IPv4 ou IPv6
  userAgent       String?     @map("user_agent") @db.VarChar(500)
  createdAt       DateTime    @default(now()) @map("created_at")
  revokedAt       DateTime?   @map("revoked_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@map("consents")
}

enum ConsentType {
  CGU // Conditions Générales d'Utilisation
  PRIVACY_POLICY // Politique de confidentialité
  COOKIES_ANALYTICS // Cookies analytiques (opt-in)
  MARKETING_EMAIL // Emails marketing (opt-in, séparé du transactionnel)
}

// ============================================================================
// AUDIT TRAIL
// ============================================================================

/// Journal d'audit pour toutes les mutations critiques
model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String?     @map("user_id") @db.Uuid // null si action système
  action    AuditAction
  entity    String      @db.VarChar(100) // ex: "User", "Order", "Subscription"
  entityId  String?     @map("entity_id") @db.Uuid
  changes   Json        @default("{}") @db.JsonB // { before: {...}, after: {...} } — JAMAIS de données personnelles
  ipAddress String?     @map("ip_address") @db.VarChar(45)
  userAgent String?     @map("user_agent") @db.VarChar(500)
  createdAt DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// JOURS DE TOURNÉE CONFIGURABLES
// ============================================================================

/// Jours de livraison configurables par zone (ex: lundi et jeudi).
///
/// Déjà seedé depuis l'origine (seed.ts) mais resté inexploitable : sans relation
/// Prisma, aucune requête ne pouvait joindre une zone à ses jours de tournée. La
/// relation ci-dessous le raccorde — c'est la base du calendrier des passages,
/// qu'il aurait été absurde de réinventer sous forme d'un moteur de récurrence.
model DeliverySchedule {
  id        String  @id @default(uuid()) @db.Uuid
  zoneId    String  @map("zone_id") @db.Uuid
  dayOfWeek Int     @map("day_of_week") // 0=dimanche, 1=lundi, ..., 6=samedi
  timeStart String  @map("time_start") @db.VarChar(5) // ex: "08:00"
  timeEnd   String  @map("time_end") @db.VarChar(5) // ex: "12:00"
  isActive  Boolean @default(true) @map("is_active")

  zone DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, dayOfWeek])
  @@index([zoneId])
  @@map("delivery_schedules")
}
