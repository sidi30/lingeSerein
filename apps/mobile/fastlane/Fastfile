# Chaîne iOS SANS Expo côté service : ni compte EAS, ni EXPO_TOKEN, ni quota de
# builds, ni magasin de credentials chez un tiers. Xcode compile, fastlane signe
# avec NOTRE clé App Store Connect, et l'API d'Apple reçoit le binaire.
#
# Le seul Expo qui subsiste ici est l'outil LOCAL `expo prebuild`, qui génère le
# projet natif `ios/` à partir d'`app.json` (le dépôt n'en versionne aucun). Il ne
# contacte aucun serveur Expo. Pour supprimer jusqu'à cette dépendance, il
# faudrait committer `ios/` et le maintenir à la main — les permissions, l'icône
# et les entitlements cesseraient alors d'être décrits par `app.json`.
#
# Secrets attendus (déjà posés sur le dépôt) :
#   ASC_KEY_ID · ASC_ISSUER_ID · ASC_KEY_P8_BASE64
#
# La clé App Store Connect sert TROIS fois, ce qui est la raison d'être de ce
# fichier : lire le dernier numéro de build TestFlight, réparer la signature
# (capability + profil), puis téléverser. Aucun mot de passe Apple, aucune 2FA,
# donc aucune étape interactive.

require "base64"
require "tmpdir"

default_platform(:ios)

APP_IDENTIFIER = "fr.linge-serein.app"
TEAM_ID = "4SRJRX4N45"

# Certificat de distribution dédié à cette CI — le seul du compte dont la clé
# privée nous appartient (les autres vivent chez EAS). Un identifiant de
# certificat n'est pas un secret : il ne sert à rien sans la clé privée, elle-même
# dans le secret `IOS_DIST_P12_BASE64`.
CERT_ID = ENV["IOS_DIST_CERT_ID"] || "442CB4GWDC"

# Racine du projet mobile, ancrée sur l'emplacement de CE fichier.
#
# Indispensable : fastlane exécute la lane depuis son propre dossier `fastlane/`,
# pas depuis `apps/mobile`. Des chemins relatifs en `ios/...` visaient donc
# `apps/mobile/fastlane/ios/`, qui n'existe pas — le premier run a échoué là,
# sur un projet natif pourtant correctement généré.
MOBILE_ROOT = File.expand_path("..", __dir__)

# Le projet natif est produit par `expo prebuild` : ses noms de fichiers dérivent
# du `name` d'app.json et changeraient sans prévenir si celui-ci évoluait. On les
# découvre plutôt que de les figer — un nom en dur ici casserait le build au
# premier renommage de l'app, avec un message incompréhensible.
def natif
  workspace = Dir[File.join(MOBILE_ROOT, "ios", "*.xcworkspace")].first
  if workspace.nil?
    UI.user_error!("Aucun .xcworkspace sous #{MOBILE_ROOT}/ios : `expo prebuild` n'a pas tourné")
  end
  {
    workspace: workspace,
    scheme: File.basename(workspace, ".xcworkspace"),
    project: Dir[File.join(MOBILE_ROOT, "ios", "*.xcodeproj")].first,
  }
end

platform :ios do
  desc "Compile l'IPA et l'envoie sur TestFlight"
  lane :beta do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false,
    )

    # Trousseau temporaire, détruit avec le runner. Sans lui, l'import du
    # certificat échoue sur un trousseau verrouillé et le build s'arrête après
    # dix minutes de compilation.
    setup_ci if ENV["CI"]

    app = natif

    # ---- Numéro de build : c'est TestFlight qui fait foi ----
    #
    # `eas.json` déléguait ce compteur aux serveurs d'EAS (`appVersionSource:
    # remote`). En sortant d'Expo, la seule source de vérité restante est Apple
    # lui-même : on prend le dernier numéro connu et on l'incrémente. Repartir de
    # `app.json` produirait un doublon, qu'App Store Connect refuse.
    dernier = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0,
    )
    increment_build_number(build_number: dernier + 1, xcodeproj: app[:project])
    UI.message("Numéro de build : #{dernier + 1} (dernier sur TestFlight : #{dernier})")

    # ---- Capability Push Notifications ----
    #
    # Rien à faire ici, et c'est vérifié : l'App ID `fr.linge-serein.app`
    # (`9FQ368JZFN`) porte déjà `PUSH_NOTIFICATIONS` et `IN_APP_PURCHASE`.
    # `produce` avait été essayé pour l'activer, mais il n'accepte PAS de clé API
    # (« Could not find option 'api_key' ») : il exige un identifiant Apple et
    # donc une 2FA, incompatible avec un runner. Si la capability venait à
    # manquer sur une future app, l'activer par l'API plutôt que par fastlane :
    # POST /v1/bundleIdCapabilities {capabilityType: "PUSH_NOTIFICATIONS"}.
    # Le `sigh(force: true)` plus bas suffit ensuite à faire entrer la capability
    # dans le profil.

    # ---- Signature ----
    #
    # Le certificat de distribution est IMPORTÉ, jamais créé ici.
    #
    # `cert` a été essayé et écarté : il crée bien un certificat sur le portail
    # mais échoue à l'installer dans le trousseau temporaire de la CI
    # (« Could not find the newly generated certificate installed »). Chaque
    # tentative laissait derrière elle un certificat dont la clé privée mourait
    # avec le runner — inutilisable à jamais, et occupant un des rares slots
    # qu'Apple accorde. Le certificat utilisé ici a donc été généré une fois pour
    # toutes hors CI (clé privée + CSR en local, création via l'API), puis déposé
    # en secret. Sa clé privée est archivée dans le magasin local de l'auteur.
    p12 = File.join(Dir.tmpdir, "ios-dist.p12")
    File.binwrite(p12, Base64.decode64(ENV.fetch("IOS_DIST_P12_BASE64")))
    import_certificate(
      certificate_path: p12,
      certificate_password: ENV.fetch("IOS_DIST_P12_PASSWORD"),
      keychain_name: ENV["MATCH_KEYCHAIN_NAME"] || "fastlane_tmp_keychain",
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"] || "",
    )
    File.delete(p12) if File.exist?(p12)

    # `force: true` : on REGÉNÈRE le profil à chaque build plutôt que de réutiliser
    # celui du portail. C'est ce qui fait entrer la capability activée juste avant
    # dans le profil — un profil existant ne se met jamais à jour tout seul, et
    # c'est exactement le piège qui a coûté trois builds.
    sigh(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      team_id: TEAM_ID,
      force: true,
      # Certificat EXPLICITE : le compte en porte plusieurs, tous détenus par EAS
      # sauf celui-ci. Laisser fastlane choisir produirait un profil adossé à un
      # certificat dont la clé privée n'est pas sur le runner — la compilation
      # irait jusqu'au bout avant d'échouer à l'export, 25 minutes plus tard.
      cert_id: CERT_ID,
    )

    build_app(
      workspace: app[:workspace],
      scheme: app[:scheme],
      configuration: "Release",
      # `expo prebuild` laisse DEVELOPMENT_TEAM VIDE — c'est EAS qui l'injectait
      # au moment du build. Sans ces réglages, xcodebuild s'arrête sur « Signing
      # for "LingeSerein" requires a development team », après avoir pourtant
      # compilé les pods. La signature est explicitement manuelle et adossée au
      # profil que `sigh` vient de régénérer : en automatique, Xcode choisirait
      # volontiers un profil de développement, impubliable sur TestFlight.
      xcargs: [
        "DEVELOPMENT_TEAM=#{TEAM_ID}",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY='Apple Distribution'",
        "PROVISIONING_PROFILE_SPECIFIER='#{lane_context[SharedValues::SIGH_NAME]}'",
      ].join(" "),
      export_method: "app-store",
      output_name: "LingeSerein.ipa",
      # Absolu, pour la même raison que MOBILE_ROOT : l'IPA doit atterrir dans
      # `apps/mobile/`, où le workflow va le chercher, et non sous `fastlane/`.
      output_directory: MOBILE_ROOT,
      clean: true,
      # Signature manuelle : le profil qu'on vient de régénérer, pas celui que
      # Xcode choisirait tout seul (il prend volontiers un profil de dev).
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          APP_IDENTIFIER => lane_context[SharedValues::SIGH_NAME],
        },
      },
    )

    next if options[:submit] == false

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      # On n'attend pas les 5 à 10 minutes de traitement d'Apple : le runner
      # coûte 10× le prix d'un runner Linux à la minute, et l'état final se lit
      # dans App Store Connect.
      skip_waiting_for_build_processing: true,
    )
  end
end
