# Vitrine Linge Serein — variables d'environnement (exemple)
#
# IMPORTANT : export statique (next.config.ts → output: "export").
# Ces variables NEXT_PUBLIC_* sont INLINÉES AU BUILD (`next build`), pas lues au runtime nginx.
# Elles DOIVENT donc être définies dans l'environnement AU MOMENT du build, sinon elles
# restent inactives (aucun script GA ni meta de vérification n'est émis dans le HTML exporté).

# URL du mailer (endpoints /api/contact et /api/devis). Optionnel : défaut https://api.lingeserein.fr
NEXT_PUBLIC_MAILER_URL=

# Google Analytics 4 — ID de mesure (format G-XXXXXXXXXX).
# Laisser vide pour désactiver GA (inactif par défaut).
NEXT_PUBLIC_GA_ID=

# Google Search Console — jeton de la balise meta de vérification (contenu de google-site-verification).
# Laisser vide tant que la vérification n'est pas requise (meta absente par défaut).
NEXT_PUBLIC_GSC_VERIFICATION=
